import 'package:flutter/material.dart';
import 'package:cloud_firestore/cloud_firestore.dart';
import '../routes/app_routes.dart';

/// Écran de liste des sourates du Coran
/// Charge les sourates depuis Firestore et permet la navigation vers le détail
class QuranScreen extends StatefulWidget {
  const QuranScreen({super.key});

  @override
  State<QuranScreen> createState() => _QuranScreenState();
}

class _QuranScreenState extends State<QuranScreen> {
  final FirebaseFirestore _firestore = FirebaseFirestore.instance;
  List<Map<String, dynamic>> _suras = [];
  bool _isLoading = true;
  String? _errorMessage;
  String _searchQuery = '';

  @override
  void initState() {
    super.initState();
    _loadSuras();
  }

  /// Charge la liste des sourates depuis Firestore
  /// Collection 'quran' avec structure: { sura_number, name, verses }
  Future<void> _loadSuras() async {
    try {
      setState(() {
        _isLoading = true;
        _errorMessage = null;
      });

      final querySnapshot = await _firestore
          .collection('quran')
          .orderBy('sura_number')
          .get();

      if (mounted) {
        setState(() {
          _suras = querySnapshot.docs.map((doc) {
            final data = doc.data();
            return {
              'id': doc.id,
              'sura_number': data['sura_number'] ?? 0,
              'name': data['name'] ?? '',
              'verse_count': (data['verses'] as List?)?.length ?? 0,
            };
          }).toList();
          _isLoading = false;
        });
      }
    } catch (e) {
      if (mounted) {
        setState(() {
          _isLoading = false;
          _errorMessage = 'Erreur de chargement: $e';
        });
      }
    }
  }

  /// Filtre les sourates selon la requête de recherche
  /// Recherche dans le nom des sourates (insensible à la casse)
  List<Map<String, dynamic>> get _filteredSuras {
    if (_searchQuery.isEmpty) {
      return _suras;
    }
    
    return _suras.where((sura) {
      final name = sura['name'].toString().toLowerCase();
      return name.contains(_searchQuery.toLowerCase());
    }).toList();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.transparent,
      extendBody: true,
      body: SafeArea(
        child: Column(
          children: [
            // En-tête avec titre et recherche
            Padding(
              padding: const EdgeInsets.all(16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    'Coran',
                    style: Theme.of(context).textTheme.headlineLarge?.copyWith(
                      fontWeight: FontWeight.bold,
                      color: Colors.white,
                    ),
                  ),
                  const SizedBox(height: 16),
                  TextField(
              onChanged: (value) {
                setState(() {
                  _searchQuery = value;
                });
              },
              decoration: InputDecoration(
                hintText: 'Rechercher une sourate...',
                hintStyle: TextStyle(color: Colors.white54),
                prefixIcon: Icon(Icons.search, color: Colors.white54),
                suffixIcon: _searchQuery.isNotEmpty
                    ? IconButton(
                        icon: Icon(Icons.clear, color: Colors.white54),
                        onPressed: () {
                          setState(() {
                            _searchQuery = '';
                          });
                        },
                      )
                    : null,
                  ),
                ],
              ),
            ),
            // Corps principal
            Expanded(
              child: _buildBody(),
            ),
          ],
        ),
      ),
    );
  }

  /// Construit le corps de l'écran selon l'état actuel
  /// Gère les états: chargement, erreur, liste des sourates
  Widget _buildBody() {
    if (_isLoading) {
      return const Center(
        child: CircularProgressIndicator(),
      );
    }

    if (_errorMessage != null) {
      return _buildErrorState();
    }

    if (_suras.isEmpty) {
      return _buildEmptyState();
    }

    return _buildSurasList();
  }

  /// Affiche l'état d'erreur avec possibilité de réessayer
  Widget _buildErrorState() {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(
            Icons.error_outline,
            size: 64,
            color: Colors.red.shade300,
          ),
          const SizedBox(height: 16),
          Text(
            _errorMessage!,
            style: TextStyle(
              color: Colors.red.shade300,
              fontSize: 16,
            ),
            textAlign: TextAlign.center,
          ),
          const SizedBox(height: 24),
          ElevatedButton(
            onPressed: _loadSuras,
            child: const Text('Réessayer'),
          ),
        ],
      ),
    );
  }

  /// Affiche l'état vide quand aucune sourate n'est trouvée
  Widget _buildEmptyState() {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(
            Icons.book_outlined,
            size: 64,
            color: Colors.white30,
          ),
          const SizedBox(height: 16),
          Text(
            _searchQuery.isNotEmpty 
                ? 'Aucune sourate trouvée pour "$_searchQuery"'
                : 'Aucune sourate disponible',
            style: TextStyle(
              color: Colors.white70,
              fontSize: 16,
            ),
            textAlign: TextAlign.center,
          ),
          if (_searchQuery.isNotEmpty) ...[
            const SizedBox(height: 16),
            TextButton(
              onPressed: () {
                setState(() {
                  _searchQuery = '';
                });
              },
              child: const Text('Effacer la recherche'),
            ),
          ],
        ],
      ),
    );
  }

  /// Construit la liste des sourates avec pull-to-refresh
  Widget _buildSurasList() {
    final filteredSuras = _filteredSuras;
    
    return RefreshIndicator(
      onRefresh: _loadSuras,
      child: ListView.builder(
        padding: const EdgeInsets.all(16),
        itemCount: filteredSuras.length,
        itemBuilder: (context, index) {
          final sura = filteredSuras[index];
          return _buildSuraCard(sura);
        },
      ),
    );
  }

  /// Construit une card pour une sourate
  /// Affiche le numéro, le nom et le nombre de versets
  Widget _buildSuraCard(Map<String, dynamic> sura) {
    return Card(
      margin: const EdgeInsets.only(bottom: 8),
      child: ListTile(
        contentPadding: const EdgeInsets.symmetric(horizontal: 20, vertical: 8),
        
        // Numéro de la sourate
        leading: Container(
          width: 40,
          height: 40,
          decoration: BoxDecoration(
            color: Theme.of(context).primaryColor.withOpacity(0.1),
            borderRadius: BorderRadius.circular(8),
          ),
          child: Center(
            child: Text(
              '${sura['sura_number']}',
              style: TextStyle(
                fontWeight: FontWeight.bold,
                color: Theme.of(context).primaryColor,
              ),
            ),
          ),
        ),
        
        // Nom et détails
        title: Text(
          sura['name'] as String,
          style: const TextStyle(
            fontWeight: FontWeight.w600,
            fontSize: 16,
          ),
        ),
        subtitle: Text(
          '${sura['verse_count']} versets',
          style: TextStyle(
            color: Colors.white70,
            fontSize: 14,
          ),
        ),
        
        // Flèche de navigation
        trailing: const Icon(
          Icons.arrow_forward_ios,
          size: 16,
          color: Colors.white54,
        ),
        
        // Navigation vers le détail
        onTap: () {
          AppRoutes.navigateToSura(
            context,
            sura['id'] as String,
            sura['name'] as String,
          );
        },
      ),
    );
  }
}